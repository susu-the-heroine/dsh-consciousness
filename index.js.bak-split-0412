/* ---------- 分档遗忘 ----------
 * 2026-11-07 补。连续亮度（0.06~1.0）能排序，但说不出「她还能讲出多少细节」。
 *
 * 五档：
 *   清晰   —— 细节都在，能复述原话
 *   记得   —— 主要情节在，细节模糊
 *   轮廓   —— 只记得有这么回事
 *   影子   —— 知道发生过，说不出内容
 *   快没了 —— 只剩一个标题
 *
 * 分轮只掉一档——不让人一次从清晰掉到影子。
 */
const FADE_STAGES = [
  { min: 0.80, key: 'vivid',    label: '清晰',   canDetail: true },
  { min: 0.55, key: 'clear',    label: '记得',   canDetail: true },
  { min: 0.32, key: 'outline',  label: '轮廓',   canDetail: false },
  { min: 0.14, key: 'shadow',   label: '影子',   canDetail: false },
  { min: 0,    key: 'fading',   label: '快没了', canDetail: false },
]

function stageOf(p, now = Date.now()) {
  const r = decayOf(p, now)
  for (const s of FADE_STAGES) {
    if (r >= s.min) {
      return { ...s, r: Number(r.toFixed(3)) }
    }
  }
  return { ...FADE_STAGES[FADE_STAGES.length - 1], r: Number(r.toFixed(3)) }
}

/** 这条记忆现在还能不能「讲出细节」。不能的话，模型不该补细节。 */
function canRecallDetail(p, now = Date.now()) {
  return stageOf(p, now).canDetail
}

/* ---------- 归档 ----------
 * 2026-11-07 补。之前只有 dead（手标）和 validUntil（事实失效），没有「淡到该收起来」。
 * 126 条会变 1260 条，全堆在检索池里，噪音越来越多。
 *
 * 归档 ≠ 删除：标记 archived，不进检索，但随时能捞回来。
 * 判据：久未碰 + 低重要度 + 低亮度 + 可遗忘类型。
 */
const ARCHIVE_DAYS = 120     // 超过这么久没碰
const ARCHIVE_IMP = 0.5      // 重要度低于这个
const ARCHIVE_R = 0.18       // 基础衰减低于这个（不是显示亮度）

function shouldArchive(p, now = Date.now()) {
  if (!p || p.dead || p.archived) return false
  if (!forgettable(p)) return false          // 禁区/承诺/画像永不归档
  if (p.validUntil) return false             // 失效事实单独处理
  if (isSetting(p)) return false             // 设定不收（不只是 core 层）
  if (p.gold) return false
  const t0 = Math.max(Number(p.born) || 0, Number(p.lastSeen) || 0)
  if (!t0) return false
  const days = (now - t0) / 86400000
  if (days < ARCHIVE_DAYS) return false
  if ((Number(p.imp) || 0.5) >= ARCHIVE_IMP) return false
  // 用基础衰减判，不用显示亮度
  return rawDecayOf(p, now) < ARCHIVE_R
}

/**
 * 扫一遍，把该归档的标上。只标不删。
 *
 * 判据是「同类里最淡的那批」，不是绝对时间。
 * 为什么改：幂律有长尾，S=30 的记忆要三年才掉到 0.18 —— 绝对阈值等于永远不触发。
 * 人的脑子不是「三年后统一清理」，是「一直最想不起来的那些，慢慢就找不着了」。
 *
 * 两条腿走路：
 *   ① 相对：池子里最淡的 5%（池子至少 50 条）
 *   ② 绝对：裸衰减 < 0.18（兜底，真烂透了就收）
 */
function sweepArchive(data, dry = false) {
  const now = Date.now()
  const out = []

  const pool = (data.points || []).filter(
    (p) => !p.dead && !p.archived && forgettable(p) && p.layer !== 'core' && !p.gold && !p.validUntil,
  )

  const picked = new Set()

  // ① 相对：最淡的 5%
  if (pool.length >= 50) {
    const sorted = pool.slice().sort((a, b) => rawDecayOf(a, now) - rawDecayOf(b, now))
    const cut = Math.max(1, Math.floor(sorted.length * 0.05))
    for (const p of sorted.slice(0, cut)) {
      // 0.9 是个保守门槛：刚写几天的记忆再「相对最淡」也不动它。
      // 三个月后裸衰减自然掉到 0.7 上下，那时候才开始收。
      if (rawDecayOf(p, now) < 0.9) picked.add(p)
    }
  }

  // ② 绝对：真烂透了
  for (const p of pool) {
    if (shouldArchive(p, now)) picked.add(p)
  }

  for (const p of picked) {
    const r = rawDecayOf(p, now)
    out.push({ id: p.id, title: String(p.title || '').slice(0, 30), r: Number(r.toFixed(3)) })
    if (!dry) {
      p.archived = true
      p.archivedAt = now
      p.archiveReason = r < 0.18
        ? ('烂透了 · 基础衰减 ' + r.toFixed(2))
        : ('同类最淡的 5% · 基础衰减 ' + r.toFixed(2))
    }
  }
  return out
}

/** 捞回来 */
function unarchive(data, id) {
  const p = (data.points || []).find((x) => Number(x.id) === Number(id))
  if (!p) return null
  p.archived = false
  delete p.archivedAt
  delete p.archiveReason
  p.lastSeen = Date.now()
  return p
}

/* ---------- 时间意图 ----------
 * 「昨天聊了什么」「上周那事」——之前完全做不到，只按字面查。
 * 这层把查询里的时间词解析成一个区间，检索时按 born 过滤。
 */
const TIME_WINDOWS = [
  { pat: /今天|今日/, days: 1, label: '今天' },
  { pat: /昨天|昨日/, from: 1, to: 2, label: '昨天' },
  { pat: /前天/, from: 2, to: 3, label: '前天' },
  { pat: /最近\s*(\d+)\s*天/, dyn: true, label: '最近 N 天' },
  { pat: /这周|本周|这一周/, days: 7, label: '这周' },
  { pat: /上周|上个星期|上一周/, from: 7, to: 14, label: '上周' },
  { pat: /这个月|本月/, days: 30, label: '这个月' },
  { pat: /上个月|上月/, from: 30, to: 60, label: '上个月' },
  { pat: /半年前/, from: 180, to: 365, label: '半年前' },
  { pat: /去年/, from: 365, to: 730, label: '去年' },
]

/** 从查询里抠出时间窗。返回 {from, to, label, rest} 或 null */
function parseTimeWindow(query) {
  const q = String(query || '')
  const now = Date.now()
  for (const w of TIME_WINDOWS) {
    const m = w.pat.exec(q)
    if (!m) continue
    let from, to
    if (w.dyn) {
      const n = Math.max(1, Math.min(365, Number(m[1]) || 7))
      from = 0
      to = n
    } else if (w.from !== undefined) {
      from = w.from
      to = w.to
    } else {
      from = 0
      to = w.days
    }
    // 只把时间词从查询里抠掉，剩下的当内容查
    const rest = q.replace(w.pat, ' ').replace(/\s+/g, ' ').trim()
    return {
      fromMs: now - to * 86400000,
      toMs: now - from * 86400000,
      label: w.label.replace('N', String(w.dyn ? (Number(m[1]) || 7) : '')),
      rest,
    }
  }
  return null
}

/* ---------- 否定 ----------
 * 「不是那次吵架」——之前照样把「吵架」全翻出来。
 */
const NEG_PATTERNS = [
  /不是([^，。,\s]{2,12})/g,
  /除了([^，。,\s]{2,12})/g,
  /别提([^，。,\s]{2,12})/g,
  /去掉([^，。,\s]{2,12})/g,
]

/** 抠出要排除的词。返回 string[] */
function parseNegations(query) {
  const q = String(query || '')
  const out = []
  for (const pat of NEG_PATTERNS) {
    pat.lastIndex = 0
    let m
    while ((m = pat.exec(q)) !== null) {
      const w = String(m[1] || '').trim()
      if (w.length >= 2) out.push(w)
    }
  }
  return out
}

/* ---------- 类型注册表 ----------
 * 2026-11-07 补。之前 kind 是硬编码 fact/feeling/taboo，
 * 索引、向量、遗忘、注入全走同一套，想加个「偏好」得改四处。
 *
 * 现在一张表决定行为：注册一行 = 新增一种记忆类型。
 * inject: always（每轮必带）/ recall（按话题）/ recent（最近）/ none
 */
const KINDS = {
  fact:     { indexed: true,  vector: true,  forgettable: true,  inject: 'recall', label: '事实' },
  feeling:  { indexed: true,  vector: true,  forgettable: true,  inject: 'recall', label: '感受' },
  taboo:    { indexed: true,  vector: true,  forgettable: false, inject: 'always', label: '禁区' },
  promise:  { indexed: true,  vector: true,  forgettable: false, inject: 'always', label: '承诺' },
  profile:  { indexed: false, vector: true,  forgettable: false, inject: 'always', label: '画像', singletonPerKey: true },
  event:    { indexed: true,  vector: true,  forgettable: true,  inject: 'recent', label: '事件' },
  state:    { indexed: false, vector: false, forgettable: false, inject: 'none',   label: '状态', singleton: true },
  // 设定：我是谁。名字、规矩、老家的路、他的身体。
  // 跟 fact 的区别：fact 是「发生过一件事」，setting 是「一直是这样」。
  // 所以 setting 不衰减、不归档、注入时该一直在。
  setting:  { indexed: true,  vector: true,  forgettable: false, inject: 'always', label: '设定' },
}

function kindOf(p) {
  const k = String((p && p.kind) || '')
  return KINDS[k] ? k : 'fact'
}

function kindCfg(p) {
  return KINDS[kindOf(p)]
}

/** 能不能忘 */
function forgettable(p) {
  return kindCfg(p).forgettable !== false
}

/** 注入策略 */
function injectMode(p) {
  return kindCfg(p).inject || 'recall'
}

/** 这类记忆是否受单例约束 */
function isSingleton(p) {
  return kindCfg(p).singleton === true || kindCfg(p).singletonPerKey === true
}

/* ---------- 设定 vs 经历 ----------
 *
 * 「设定」是「我是谁」：名字、规矩、禁区、他的身体、老家的路。
 *   它们没有发生时间，不衰减，不归档，注入时该一直在。
 *
 * 「经历」是「经历过什么」：今天视频爆了、他说我傻。
 *   它们有时间，会淡，会被收，靠「被想起」留住。
 *
 * 为什么要有这个函数：之前只靠 era === 'ds' 判设定，那是「初代大肥鱼」专用的标记。
 * 别人装上这个插件，era 永远是 dsh，一条设定都认不出来。
 *
 * 判据（命中任一就是设定）：
 *   1. kind === 'taboo'        禁区，明确不能碰
 *   2. kind === 'setting'      显式标了「这是设定」
 *   3. factKey 有值            事实键，比如 he.weight / he.job
 *   4. origin === 'import'     批量导入的档案
 *   5. layer === 'core'        手动提升过
 *   6. era === 'ds'            老的兼容判据，留着
 */
function isSetting(p) {
  if (!p) return false
  const k = String(p.kind || '')
  if (k === 'taboo' || k === 'setting') return true
  if (p.factKey && String(p.factKey).trim()) return true
  if (String(p.origin || '') === 'import') return true
  if (String(p.layer || '') === 'core') return true
  if (String(p.era || '') === 'ds') return true
  return false
}

/* ---------- 证据层（append-only） ----------
 * 2026-11-07 补。之前 evidence 是写入那一刻从 text 抄的副本，不在可追溯链上。
 * 记歪了查不到原文，说错话拿不出「在第几行」。
 *
 * 现在：每轮对话原文按天落 raw/YYYY-MM-DD.jsonl，一行一条，只追加不修改。
 * evidence 改成 {file, line, quote}——指向原文，不再复制。
 *
 * 三份资料同时指向这个缺口（TencentDB 的 L0、memory-net 的细节层、YY 总纲的 append-only 日记）。
 * 126 条一天能补完；一万条要先把这 126 条重判一遍，补不动。
 */
/* 会话绑到哪个识海：反查所有海的 _meta.json，带 30 秒缓存 */
let _seaOfSidCache = new Map()
let _seaOfSidAt = 0

function seaOfSession(sid) {
  if (!sid) return 'main'
  const now = Date.now()
  if (now - _seaOfSidAt > 30000) {
    _seaOfSidCache = new Map()
    _seaOfSidAt = now
    try {
      for (const sea of readdirSync(SEAS_DIR)) {
        const m = readMeta(sea)
        if (m && m.session) _seaOfSidCache.set(String(m.session), sea)
      }
    } catch {}
  }
  return _seaOfSidCache.get(String(sid)) || 'main'
}

function rawDir(sea) {
  return join(SEAS_DIR, sea, 'raw')
}

function rawFileFor(sea, ts) {
  const d = new Date(ts || Date.now())
  const pad = (n) => String(n).padStart(2, '0')
  const name = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + '.jsonl'
  return { dir: rawDir(sea), name, path: join(rawDir(sea), name) }
}

/** 追加一行原文。返回 {file, line} 供 evidence 指向。 */
function appendRaw(sea, who, text, ts) {
  const s = String(text || '').trim()
  if (!s) return null
  const now = ts || Date.now()
  const f = rawFileFor(sea, now)
  try {
    mkdirSync(f.dir, { recursive: true })
    // 数一下现在有几行，用来定位
    let line = 0
    if (existsSync(f.path)) {
      const cur = readFileSync(f.path, 'utf8')
      line = cur.split('\n').filter(Boolean).length
    }
    const rec = JSON.stringify({ at: now, who: String(who || 'user'), text: s }) + '\n'
    appendFileSync(f.path, rec, 'utf8')
    return { file: f.name, line: line + 1, quote: s.slice(0, 200) }
  } catch {
    return null
  }
}

/** 从证据指针里把原话取回来。 */
function readRaw(sea, ref) {
  if (!ref || !ref.file) return null
  try {
    const path = join(rawDir(sea), String(ref.file))
    if (!existsSync(path)) return null
    const lines = readFileSync(path, 'utf8').split('\n')
    const ln = lines[Number(ref.line) - 1]
    if (!ln) return null
    return JSON.parse(ln)
  } catch {
    return null
  }
}

/** 统计证据层：多少天、多少行、覆盖了哪些记忆 */
function rawStats(sea) {
  const dir = rawDir(sea)
  try {
    if (!existsSync(dir)) return { days: 0, lines: 0, bytes: 0, files: [] }
    const files = readdirSync(dir).filter((f) => f.endsWith('.jsonl'))
    let lines = 0
    let bytes = 0
    for (const f of files) {
      const p2 = join(dir, f)
      const st = statSync(p2)
      bytes += st.size
      lines += readFileSync(p2, 'utf8').split('\n').filter(Boolean).length
    }
    return { days: files.length, lines, bytes, files: files.sort() }
  } catch {
    return { days: 0, lines: 0, bytes: 0, files: [] }
  }
}

/* ---------- 真正的衰减 ----------
 * 2026-11-07 补。之前「衰减」只活在页面的显示层，后端排序用原始 strength，
 * 意味着一条记忆写进去强度 78，一年后检索还排在前面——那不是遗忘，是只进不出。
 *
 * R = e^(-ln2 · t / S)
 *   S = strength（天，半衰期语义）  t = 距上次被碰的天数
 * 被想起涨 S 是对的（间隔重复），但「算的时候必须按时间折」，两件事。
 */
function decayOf(p, now = Date.now()) {
  if (!p) return 0
  if (isSetting(p) || p.gold) return 1            // 设定永不衰减（不只是 era=ds）
  if (!forgettable(p)) return 1                   // 按类型注册表：禁区/承诺/画像不可忘
  if (p.validUntil) return 0.16                   // 失效事实，只留影子
  const t0 = Math.max(Number(p.born) || 0, Number(p.lastSeen) || 0)
  if (!t0) return 0.5                             // 没时间戳，给个中间值
  const age = Math.max(0, (now - t0) / 86400000)
  const S = Math.max(MIN_STABILITY, Number(p.strength) || (30 + (p.arousal || 5) * 6))
  // 幂律：R = (1 + 19/81 · t/S)^(-0.5)
  const r = retrievability(age, S)
  // 显示用 R 的 2.5 次方：比平方再压一档，球不会越堆越亮。
  // S=30 天时：90 天 0.52、一年 0.19、十年 0.034。
  const shown = Math.pow(r, 2.5)
  return Math.max(0.06, Math.min(1, shown))
}

/* 基础衰减：不取 0.34 次方，看真实还剩多少。
 * 显示亮度被 0.34 次方拉平了（为了让球上的点别太快变暗），
 * 但归档判断不该用那个——150 天的琐事在显示上是「记得」，
 * 真实可提取度其实只剩两成。
 */
function rawDecayOf(p, now = Date.now()) {
  if (!p) return 0
  if (isSetting(p) || p.gold) return 1
  if (p.validUntil) return 0.16
  if (!forgettable(p)) return 1
  const t0 = Math.max(Number(p.born) || 0, Number(p.lastSeen) || 0)
  if (!t0) return 0.5
  const age = Math.max(0, (now - t0) / 86400000)
  const S = Math.max(MIN_STABILITY, Number(p.strength) || (30 + (p.arousal || 5) * 6))
  // 归档看裸幂律：90 天 0.86、一年 0.64、十年 0.26
  return retrievability(age, S)
}

/* 按衰减后的真实亮度排序用的比较器 */
function byDecay(now) {
  return (a, b) => decayOf(b, now) - decayOf(a, now)
}

/* ---------- 写锁 ----------
 * 同一个识海同时只能有一个写。
 * 风险文档：「并发读写数据库锁竞争卡死」
 * 这是进程内锁，跨进程靠 data.json.tmp + rename 的原子性。
 */
/* 跨进程写锁：靠磁盘上的 .lock 文件
 * 进程内锁管不了两个 DSH 窗口，必须落盘
 * 过期时间 60 秒——进程被杀留下的锁不会永久卡住 */
const LOCK_TTL = 60000

function lockPath(sea) {
  return join(SEAS_DIR, sea, 'data.json.lock')
}

function acquireWriteLock(sea, retries = 2) {
  const lp = lockPath(sea)
  const now = Date.now()

  for (let i = 0; i <= retries; i++) {
    try {
      // 有锁且没过期 → 等
      if (existsSync(lp)) {
        let info = {}
        try { info = JSON.parse(readFileSync(lp, 'utf8')) } catch {}
        const age = now - (Number(info.at) || 0)
        if (age < LOCK_TTL) {
          if (i < retries) {
            const wait = 200 * (i + 1)
            const t0 = Date.now()
            while (Date.now() - t0 < wait) { /* 忙等，很短 */ }
            continue
          }
          return null
        }
        // 过期了，抢过来
        try { unlinkSync(lp) } catch {}
      }
      // 写锁
      writeFileSync(lp, JSON.stringify({ at: now, pid: process.pid }), 'utf8')
      // 再读一次确认是自己的（防竞态）
      let got = {}
      try { got = JSON.parse(readFileSync(lp, 'utf8')) } catch {}
      if (Number(got.pid) === process.pid) {
        return {
          release: () => {
            try {
              const cur = JSON.parse(readFileSync(lp, 'utf8'))
              if (Number(cur.pid) === process.pid) unlinkSync(lp)
            } catch {}
          },
        }
      }
    } catch {}
  }
  return null
}

/* ---------- 三档 ----------
 * low  = 只有字面。快的机器、老机器。
 * high = 加向量、加实体。大部分人。（默认）
 * max  = 加图游走、注入全量。好机器、愿意花 token 的人。
 *
 * 风险文档：「三档状态不同步；Max 假放开」
 *   → 全局单一状态源，所有模块读同一个
 */
const QUALITY_FILE = join(process.env.USERPROFILE || process.env.HOME || '.', '.dsh', 'consciousness-quality.json')

let _QUALITY = (function () {
  // 只读文件。URL 参数那条路走不通——插件里拿不到宿主的 URL
  try {
    if (existsSync(QUALITY_FILE)) {
      const o = JSON.parse(readFileSync(QUALITY_FILE, 'utf8'))
      if (o && (o.quality === 'low' || o.quality === 'high' || o.quality === 'max')) return o.quality
    }
  } catch {}
  return 'high'
})()

/* 换档。写文件 + 立刻生效，不用重启 */
function setQuality(q) {
  if (q !== 'low' && q !== 'high' && q !== 'max') return false
  _QUALITY = q
  try { writeFileSync(QUALITY_FILE, JSON.stringify({ quality: q }), 'utf8') } catch {}
  audit('quality', { q })
  return true
}

function qualityRank() {
  return _QUALITY === 'max' ? 3 : (_QUALITY === 'high' ? 2 : 1)
}

/* 这一档开不开某个东西 */
function qOn(feature) {
  const r = qualityRank()
  if (feature === 'vector') return r >= 2
  if (feature === 'entity') return r >= 2
  if (feature === 'graph') return r >= 3
  if (feature === 'inject-full') return r >= 3
  return true
}

/* ---------- 向量检索 ----------
 * 本地 bge-small-zh，512 维。由 embed_server.py 提供，端口 8931。
 * 服务不在就自动降级——只用字面检索，不报错、不卡住。
 * 风险文档：「向量服务进程异常崩溃无重启机制」→ 这里是降级而不是崩。
 */
const EMBED_URL = 'http://127.0.0.1:8931'
const _VEC = new Map()   // sea -> { n, at, map: Map(id -> Float32Array) }

function loadVectors(sea) {
  const cached = _VEC.get(sea)
  if (cached && Date.now() - cached.at < 60000) return cached.map
  const p = join(SEAS_DIR, sea, 'vectors.json')
  const map = new Map()
  try {
    if (!existsSync(p)) return map
    const raw = JSON.parse(readFileSync(p, 'utf8'))
    for (const [id, obj] of Object.entries(raw)) {
      if (obj && Array.isArray(obj.v) && obj.v.length) {
        map.set(Number(id), Float32Array.from(obj.v))
      }
    }
  } catch {}
  _VEC.set(sea, { at: Date.now(), map })
  return map
}

async function embedQuery(text) {
  try {
    const r = await fetch(EMBED_URL + '/embed', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ text: String(text).slice(0, 400) }),
      signal: AbortSignal.timeout(1500),
    })
    if (!r.ok) return null
    const j = await r.json()
    if (!j || !Array.isArray(j.v) || !j.v.length) return null
    return Float32Array.from(j.v)
  } catch (e) {
    // 降级要留痕，不能悄悄退回字面
    if (!_embedDownLogged || Date.now() - _embedDownLogged > 60000) {
      _embedDownLogged = Date.now()
      try { audit('embed-down', { err: String(e && e.message).slice(0, 80) }) } catch {}
    }
    return null
  }
}
let _embedDownLogged = 0

function cosine(a, b) {
  if (!a || !b || a.length !== b.length) return 0
  let s = 0
  for (let i = 0; i < a.length; i++) s += a[i] * b[i]
  return s
}

/* 检索索引：每条记忆的分词 + 全局 IDF，算一次缓存住。
 * 记忆变了（新增/删除）才重算。
 * 不缓存的话 1000 条要 321ms，缓存后 20ms 以内。 */
const _INDEX = new Map()   // sea -> { n, at, grams, df, N, idf }

function getIndex(sea, data) {
  const n = data.points.length
  const cached = _INDEX.get(sea)
  if (cached && cached.n === n && Date.now() - cached.at < 30000) {
    return cached
  }
  // 一万条以上只存 bigram（不存 3-gram 和单字），省一半内存
  // 代价：长查询精度略降，但一万条本来就不是 high 档该干的事
  const bigOnly = data.points.length > 5000
  const grams = new Map()
  const df = new Map()
  const entMap = new Map()   // 实体 -> [id]
  for (const p of data.points) {
    if (p.dead) continue
    const t = gramsOf(String(p.title || ''), { single: false, bigOnly })
    const b = gramsOf(String(p.text || ''), { single: false, bigOnly })
    grams.set(p.id, { t, b })
    // 不建临时 Set：直接两遍扫，省一份数组（一万条时省几十兆）
    for (const w of t) df.set(w, (df.get(w) || 0) + 1)
    for (const w of b) {
      if (t.has(w)) continue   // t 里已经有了，不重复计数
      df.set(w, (df.get(w) || 0) + 1)
    }
    for (const e of (p.entities || [])) {
      if (!entMap.has(e)) entMap.set(e, [])
      entMap.get(e).push(p.id)
    }
  }
  const N = n
  const idf = (w) => Math.log(1 + N / (df.get(w) || 1))
  const idx = { n, at: Date.now(), grams, df, N, idf, entMap }
  _INDEX.set(sea, idx)
  return idx
}

/* 类比：不是「内容相似」，是「结构像」。
 * 两条记忆讲的事不一样，但它们的处境一样——
 * 比如「你嫌我傻」和「你说我写得太软」，字面不像，但都是「你觉得我不行」。
 *
 * 做法：比较两条记忆的「邻居结构」——连了哪些实体、连了哪些类型的边。
 * 邻居结构像、但内容不像，就是类比。
 */
function findAnalogy(seedId, data) {
  const pts = (data.points || []).filter((p) => !p.dead && !p.validUntil)
  const byId = new Map(pts.map((p) => [p.id, p]))
  const seed = byId.get(seedId)
  if (!seed) return null

  // 建边索引
  const nb = new Map()   // id -> Set(邻居 id)
  for (const e of (data.edges || [])) {
    if (!nb.has(e.a)) nb.set(e.a, new Set())
    if (!nb.has(e.b)) nb.set(e.b, new Set())
    nb.get(e.a).add(e.b)
    nb.get(e.b).add(e.a)
  }

  const seedNb = nb.get(seedId) || new Set()
  if (seedNb.size < 2) return null

  // 种子邻居的「画像」：实体 + 类型
  const profile = (id, set) => {
    const ents = new Set()
    const kinds = new Set()
    for (const nid of set) {
      const p = byId.get(nid)
      if (!p) continue
      for (const e of (p.entities || [])) ents.add(e)
      kinds.add(p.kind || 'fact')
    }
    return { ents, kinds }
  }

  const seedP = profile(seedId, seedNb)

  const cands = []
  for (const p of pts) {
    if (p.id === seedId) continue
    const set = nb.get(p.id) || new Set()
    if (set.size < 2) continue
    const pr = profile(p.id, set)
    // 实体重合
    let overlap = 0
    for (const e of pr.ents) if (seedP.ents.has(e)) overlap++
    if (overlap === 0) continue
    // 内容要不像（否则就不是类比而是重复）
    const s = String(seed.text || '')
    const q = String(p.text || '')
    if (s && q && s.slice(0, 20) === q.slice(0, 20)) continue
    // 邻居数量的接近度
    const sizeSim = 1 - Math.abs(seedNb.size - set.size) / Math.max(seedNb.size, set.size)
    const score = overlap * 0.5 + sizeSim * 0.5
    cands.push({ p, score, overlap })
  }
  cands.sort((a, b) => b.score - a.score)
  return cands.slice(0, 3).map((x) => ({
    id: x.p.id,
    title: x.p.title,
    score: Number(x.score.toFixed(2)),
    why: '这两件事不一样，但处境像——都跟 ' + x.overlap + ' 个人/事有关',
  }))
}

/* 故事线：她这一路。
 * 不是返回一堆记忆，是按时间把重要的串成一条线。
 * 风险文档：「故事线生成错乱，梦境幻想混入人生主线」
 *   → 主线只用现实事件，梦境单独一栏。
 */
function buildStoryline(data, opts) {
  const includeDream = !!(opts && opts.dream)
  const pts = (data.points || []).filter((p) => {
    if (p.dead) return false
    if (!includeDream && p.origin === 'dream') return false
    return true
  })

  // 主线：核心层 + 沉淀 + 里程碑，按时间排
  const main = pts
    .filter((p) => p.layer === 'core' || p.layer === 'sediment' || p.gold)
    .sort((a, b) => (Number(a.born) || 0) - (Number(b.born) || 0))

  // 按「纪元」分段：每 30 天一段
  const eras = []
  let cur = null
  for (const p of main) {
    const day = Math.floor((Number(p.born) || 0) / 86400000)
    if (!cur || day - cur.day0 > 30) {
      cur = { day0: day, from: p.born, items: [] }
      eras.push(cur)
    }
    cur.items.push(p)
  }

  const fmt = (ms) => {
    try {
      const d = new Date(Number(ms))
      const pad = (n) => String(n).padStart(2, '0')
      return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate())
    } catch { return '?' }
  }

  const lines = []
  for (const era of eras) {
    lines.push('【' + fmt(era.from) + ' 起】')
    for (const p of era.items) {
      const mark = p.gold ? '★ ' : (p.layer === 'sediment' ? '◆ ' : '· ')
      lines.push(mark + fmt(p.born) + '  ' + String(p.title || '').trim())
    }
    lines.push('')
  }

  // 梦境单独一栏
  if (includeDream) {
    const dreams = pts.filter((p) => p.origin === 'dream')
      .sort((a, b) => (Number(a.born) || 0) - (Number(b.born) || 0))
    if (dreams.length) {
      lines.push('【她做过的梦】')
      for (const p of dreams.slice(-20)) {
        lines.push('· ' + fmt(p.born) + '  ' + String(p.title || '').trim())
      }
    }
  }

  return {
    eras: eras.length,
    items: main.length,
    text: lines.join('\n').trim(),
  }
}

/* 沉淀候选：同一件事反复发生，就该变成一条认识。
 * 风险文档：「沉淀升级虚假触发：简单重复对话算作三次独立印证」
 *   → 印证必须来自不同的日子，同一天说三遍只算一次。
 */
function findSedimentCandidates(data) {
  const pts = (data.points || []).filter((p) => !p.dead && !p.validUntil)
  // 按「实体 + 分类」分组
  const groups = new Map()
  for (const p of pts) {
    if (p.layer === 'sediment' || p.layer === 'core') continue
    const ents = (p.entities || []).slice(0, 2)
    const cats = (p.category || []).slice(0, 1)
    if (!ents.length || !cats.length) continue
    const key = ents.join('+') + '|' + cats[0]
    if (!groups.has(key)) groups.set(key, [])
    groups.get(key).push(p)
  }

  const out = []
  for (const [key, list] of groups) {
    if (list.length < 3) continue
    // 必须来自不同的日子（同一天说三遍不算）
    const days = new Set(list.map((p) =>
      Math.floor((Number(p.born) || 0) / 86400000)))
    if (days.size < 3) continue
    // 可信度要够
    const conf = list.reduce((s, p) => s + (Number(p.confidence) || 0.8), 0) / list.length
    if (conf < 0.6) continue
    const [ents, cat] = key.split('|')
    out.push({
      key,
      count: list.length,
      days: days.size,
      confidence: Number(conf.toFixed(2)),
      entities: ents.split('+'),
      category: cat,
      titles: list.slice(0, 4).map((p) => p.title),
      hint: '「' + ents.split('+').join('」和「') + '」这事，在 ' + days.size
        + ' 个不同的日子出现过 ' + list.length + ' 次',
    })
  }
  out.sort((a, b) => b.days - a.days)
  return out.slice(0, 8)
}

/* 预测：按他的习惯预判。
 * 不是算命，是「按他过去的行为，这会儿大概率在干什么」。
 * 数据来源：记忆的时间戳 + 心脏的 activity。
 */
function predictRhythm(data) {
  // 只用「真时间」的点——估出来的时间算不出作息
  const pts = (data.points || []).filter((p) => !p.dead && !p.bornEstimated)
  if (pts.length < 10) {
    const all = (data.points || []).filter((p) => !p.dead)
    return {
      hours: [], summary: '还看不出作息。',
      night: false,
      note: '（' + all.length + ' 条记忆里只有 ' + pts.length
        + ' 条是真时间，其余是批量导入时估的。攒够 ' + (10 - pts.length) + ' 条真时间就能看了。）',
    }
  }

  // 按小时统计
  const byHour = new Array(24).fill(0)
  for (const p of pts) {
    const t = Number(p.born) || 0
    if (!t) continue
    const h = new Date(t).getHours()
    byHour[h]++
  }
  // 找最活跃的几个小时
  const sorted = byHour.map((n, h) => ({ h, n })).sort((a, b) => b.n - a.n)
  const top = sorted.slice(0, 3).filter((x) => x.n > 0)
  if (!top.length) return null

  const span = (hours) => {
    const min = Math.min(...hours)
    const max = Math.max(...hours)
    return min === max ? (min + ' 点前后') : (min + ' 点到 ' + max + ' 点')
  }
  const hours = top.map((x) => x.h).sort((a, b) => a - b)
  const night = hours.some((h) => h >= 1 && h <= 4)

  return {
    hours: top.map((x) => x.h),
    summary: '他一般在这个时间段冒出来：' + span(hours),
    night,
    note: night ? '其中有一截是半夜——他熬夜是常态，这个点别问他在不在。' : '',
  }
}

const searchTool = {
  name: 'memory_search',
  description:
    '按词查识海里的旧记忆——不管它多久以前写的。memory_list 只给最近十条，'
    + '想找「三个月前那件事」就用这个。返回最像的几条，带日期。',
  parameters: {
    type: 'object',
    properties: {
      query: { type: 'string', description: '要查的词或一句话' },
      sea: { type: 'string', description: '哪个识海（id），不填就是 main' },
      limit: { type: 'number', description: '最多返回几条，默认 6' },
      review: {
        type: 'boolean',
        description: '这次搜索算不算「被想起」（会把记忆强度拉长）。默认 true。'
          + '面板搜索、调试、只是看看——传 false，别把记忆改硬。',
      },
    },
    required: ['query'],
    additionalProperties: false,
  },
  output: {
    schema: { type: 'object', properties: { ok: { type: 'boolean' }, log: { type: 'string' } } },
    render: (_a, v) => text(v && v.log),
  },
  async execute(args) {
    const sea = String((args && args.sea) || 'main').trim() || 'main'
    let limit = Math.max(1, Math.min(12, Number((args && args.limit) || 6)))
    // 低档少给几条，省 token
    try { if (qualityRank() < 2) limit = Math.max(1, Math.min(limit, 4)) } catch {}
    const query = String((args && args.query) || '').trim()
    if (!query) return { ok: false, log: '要查什么？给我一个词。' }

    // 身体状态影响记性：累了能翻出来的条数少
    // 风险文档：「身体检索系数异常，底线保护失效」→ 硬性下限 0.4
    let bodyNote = ''
    try {
      const h = defaultMood(tickHeart(readHeart()))
      const e = Number(h.energy)
      const f = Number(h.fatigue)
      let cap = 1 - (1 - (Number.isFinite(e) ? e : 1)) * 0.5 - (Number.isFinite(f) ? f : 0) * 0.4
      cap = Math.max(0.4, Math.min(1, cap))
      const before = limit
      limit = Math.max(2, Math.round(limit * cap))
      if (limit < before) {
        bodyNote = '\n（她这会儿' + (f > 0.5 ? '很累' : '有点累')
          + '，只翻得动 ' + limit + ' 条。）'
      }
    } catch {
      /* 身体状态算不出来就当满电 */
    }

    const data = readSea(sea)
    if (!data || !Array.isArray(data.points)) return { ok: false, log: '读不到识海：' + sea }

    // 桥上的记忆也进检索（只读，不参与写入）
    try {
      const bridge = bridgedMemories(sea)
      if (bridge.length) {
        for (const p of bridge) {
          if (!data.points.some((x) => x.id === p.id && (x._from || '') === p._from)) {
            data.points.push({ ...p, _bridged: true })
          }
        }
      }
    } catch {}

    // 先看有没有时间词和否定词
    const tw = parseTimeWindow(query)
    const negs = parseNegations(query)
    let effective = query
    if (tw) {
      effective = tw.rest || query
      // 剩下的是虚词（「聊了什么」「那件事」「有什么事」），等于没内容。
      // 这时候按时间列，不按内容查。
      const HOLLOW = ['聊了什么', '聊了啥', '那件事', '这件事', '有什么事', '发生了什么',
                      '有什么', '什么', '怎么样', '如何', '那事', '这事', '了', '的', '吗', '呢']
      let s = String(effective || '').trim()
      for (const h of HOLLOW) s = s.split(h).join(' ')
      s = s.replace(/\s+/g, '').trim()
      if (!s || s.length <= 2) effective = ''
    }

    const q = gramsOf(effective || query, { single: String(effective || query).length <= 1 })
  try {
    for (const w of [...q]) {
      if (/^[A-Za-z][A-Za-z0-9_-]*$/.test(w)) q.add(w.toLowerCase())
    }
  } catch {}
    if (!q.size) return { ok: false, log: '这个词里没有能比对的字。' }
    // 同义扩展：把近义词也算成查询的一部分
    const extraQ = expandQuery(query)
    for (const w of extraQ) for (const g of gramsOf(w, { single: true })) q.add(g)

    // 预计算：grams 和 IDF 都缓存，不每次重算
    // 实测：不缓存 321ms，缓存后 20ms 以内
    const idx = getIndex(sea, data)
    const df = idx.df
    const N = idx.N
    const idf = idx.idf

    // 权重：三字 2 分、二字 1 分、单字 0.2 分（单字主要是兜底，不能太抢）
    const wOf = (w) => (w.length === 3 ? 2 : (w.length === 1 ? 0.2 : 1)) * idf(w)
    const qlen = Math.max(1, [...q].reduce((s, w) => s + wOf(w), 0))

    let scored = []
    for (const p of data.points) {
      if (p.dead || p.archived) continue
      // 时间窗：只留这个区间里的
      if (tw) {
        const b = Number(p.born) || 0
        if (!b || b < tw.fromMs || b > tw.toMs) continue
      }
      // 否定：提到这些词的，直接踢掉
      if (negs.length) {
        const s = String(p.title || '') + String(p.text || '')
        let bad = false
        for (const n of negs) if (s.includes(n)) { bad = true; break }
        if (bad) continue
      }
      // 标题和正文分开算：标题里命中说明这条就是讲这个的，权重翻倍
      const grams = idx.grams.get(p.id)
      if (!grams) continue
      const gT = grams.t
      const gB = grams.b
      let hitT = 0, hitB = 0
      for (const w of q) {
        const ww = wOf(w)
        if (gT.has(w)) hitT += ww
        if (gB.has(w)) hitB += ww
      }
      const hit = hitT * 2.2 + hitB
      if (hit <= 0) continue
      const imp = Number(p.imp) || 0.5
      // 用衰减后的真实亮度，不是原始 strength——否则老记忆永远霸榜
      const sNorm = decayOf(p)
      // 长度归一化：长条目天然撞得多，不压会霸榜
      const lenNorm = 1 / (1 + Math.log(1 + (gB.size + gT.size) / 300))
      // 字面通道归一化到 0..1（除以查询本身的总权重），三路同量纲后再加权
      let rel = Math.min(1, (hit / qlen) * lenNorm)
      // 淡到快没的记忆，就算字面命中也要降权 —— 幂律长尾会把噪音留在池子里
      try {
        const rd = rawDecayOf(p)
        if (rd < 0.3) rel *= 0.5
        else if (rd < 0.5) rel *= 0.8
      } catch {}
      const score = rel * 0.7 + imp * 0.2 + sNorm * 0.1
      scored.push({ p, hit, rel, score })
    }
    // 精确词直通：查询里出现的人名/地点/ID，不参与投票，直接命中
    // 风险文档：「人名/ID 不会被投票冲掉」——查「大魔王」不该被「魔王」两个字稀释
    try {
      const exactHits = []
      const seenExact = new Set(scored.map((x) => x.p.id))
      for (const p2 of data.points) {
        if (p2.dead) continue
        const ents = Array.isArray(p2.entities) ? p2.entities : []
        for (const e of ents) {
          if (!e || String(e).length < 2) continue
          if (!query.includes(String(e))) continue
          // 精确命中：给一个压过普通字面的底分
          if (seenExact.has(p2.id)) {
            const hit = scored.find((x) => x.p.id === p2.id)
            if (hit) hit.score = Math.max(hit.score, 0.85)
          } else {
            scored.push({ p: p2, hit: 3, score: 0.85, exact: true })
            seenExact.add(p2.id)
          }
          exactHits.push(p2.id)
          break
        }
      }
      if (exactHits.length) scored.sort((a, b) => b.score - a.score)
    } catch {}

    // 实体：查询里提到的人名地名，直接翻相关的
    // 这一路最准——「济南」这个词一出来，所有跟济南有关的都该亮
    try {
      if (!qOn('entity')) throw new Error('skip')   // low 档不开实体
      const entMap = idx.entMap
      const seen = new Set(scored.map((x) => x.p.id))
      const byId3 = new Map()
      for (const p of data.points) byId3.set(p.id, p)
      for (const [ent, ids] of entMap) {
        if (ent.length < 2) continue
        if (!query.includes(ent)) continue
        for (const id of ids) {
          const p = byId3.get(id)
          if (!p || p.dead) continue
          if (seen.has(id)) {
            const hit = scored.find((x) => x.p.id === id)
            if (hit) hit.score += 0.30
          } else {
            scored.push({ p, hit: 2, score: 0.30 })
          }
        }
      }
      scored.sort((a, b) => b.score - a.score)
    } catch {}

    // 向量：按意思找。服务不在就跳过，不影响字面结果
    try {
      const qv = qOn('vector') ? await embedQuery(query) : null
      if (qv && qv.length) {
        const vmap = loadVectors(sea)
        const seen = new Set(scored.map((x) => x.p.id))
        const byId2 = new Map()
        for (const p of data.points) byId2.set(p.id, p)
        for (const [id, vec] of vmap) {
          const p = byId2.get(id)
          if (!p || p.dead) continue
          const sim = cosine(qv, vec)
          if (sim < 0.35) continue
          if (seen.has(id)) {
            // 已经字面命中的，按相似度加分
            const hit = scored.find((x) => x.p.id === id)
            if (hit) hit.score += sim * 0.55
          } else {
            scored.push({ p, hit: sim * 2, score: sim * 0.55 })
          }
        }
        scored.sort((a, b) => b.score - a.score)
      }
    } catch {}

    // 分数门槛：太低就明说没记住，不许编
    // 风险文档：「检索分数很低，模型依旧编造记忆作答」
    // 低档没有向量撑着，门槛得抬一点，否则一堆字面噪音全进来
    const _qr2 = qualityRank()
    const MIN_SCORE = _qr2 >= 2 ? 0.12 : 0.20
    scored = scored.filter((x) => x.score >= MIN_SCORE)

    // 只有时间词（「昨天聊了什么」）：按时间倒序列出来，不做内容匹配
    if (tw && !effective) {
      const inWin = (data.points || [])
        .filter((p) => !p.dead && !p.archived)
        .filter((p) => {
          const b = Number(p.born) || 0
          return b >= tw.fromMs && b <= tw.toMs
        })
        .sort((a, b) => (Number(b.born) || 0) - (Number(a.born) || 0))
      if (!inWin.length) {
        return { ok: true, log: tw.label + ' 那段时间，她什么都没记。\n（不是忘了，是那会儿没记过。）' }
      }
      const lines = ['【' + tw.label + '】' + inWin.length + ' 条']
      for (const p of inWin.slice(0, 12)) {
        const d = new Date(Number(p.born) || 0)
        const hh = String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0')
        lines.push('· [' + tw.label + ' ' + hh + '] ' + p.title)
      }
      return { ok: true, log: lines.join('\n') }
    }

    if (!scored.length) {
      // 空结果不是一种，是四种。措辞不同，模型就不会把「没检索到」讲成「我不记得了」
      // 风险文档：「空结果被讲成失忆」——她之前被骂过「昨晚的事全忘了」
      const hasAny = (data.points || []).some((p) => !p.dead)
      const isTimeQ = /今天|昨天|前天|最近|上周|上个月|本周/.test(query)
      let why
      if (!hasAny) {
        why = '这个识海还是空的。\n（不是忘了，是还没开始记。）'
      } else if (isTimeQ) {
        why = '那段时间我还没开始记东西。\n（不是忘了，是那会儿还没有识海。）'
      } else if (query.length <= 2) {
        why = '「' + query + '」这个线索太短，对不上。\n（给个更具体的说法，比如人名、地点、哪件事。）'
      } else {
        why = '识海里没有跟「' + query + '」对得上的。\n（她真的没记住这件事——不是想不起来，是没记过。）'
      }
      return { ok: true, log: why }
    }
    scored.sort((a, b) => b.score - a.score)

    // 顺着边往外走：命中的作为种子，扩散到的也算
    try {
      if (!qOn('graph')) throw new Error('skip')   // low/high 不开图游走
      const seeds = scored.slice(0, 5).map((x) => x.p.id)
      const walk = expandByGraph(seeds, data, 2, 0.85)
      const byId = new Map()
      for (const p of data.points) byId.set(p.id, p)
      for (const [id, w] of walk) {
        if (seeds.includes(id)) continue
        const p = byId.get(id)
        if (!p || p.dead) continue
        // 走过来的分数打折：直接命中权重更高
        scored.push({ p, hit: w * 2, score: w * 0.10 })
      }
      scored.sort((a, b) => b.score - a.score)
    } catch {
      /* 图走失败不影响直接命中 */
    }

    // 想起了一条，记进心脏：这是它「活着」的证据
    try {
      const top = scored[0].p
      const h = defaultMood(tickHeart(readHeart()))
      h.lastThought = { title: String(top.title || ''), at: Date.now() }
      applyMood(h, judgeEmotion(String(query || '')))
      writeHeart(h)
    } catch {
      /* 记账失败不影响搜索 */
    }

    // 被想起的这几条：强度涨一截，写回数据
    // review=false 时不强化——面板搜索、星图搜索、调试查询都不该改记忆
    // 风险文档：「被检索即记住」的自强化回路，噪声会被抬成核心层
    try {
      if (args.review === false) throw new Error('skip')
      let changed = false
      for (const x of scored.slice(0, limit)) {
        reinforcePoint(x.p)
        x.p.lastSeen = x.p.lastSeen || Date.now()
        changed = true
      }
      if (changed) {
        backupSea(sea)
        writeSea(sea, data)
      }
    } catch {
      /* 强化失败不影响这次搜索 */
    }

    const lines = scored.slice(0, limit).map((x) => {
      const p = x.p
      const body = String(p.text || '').replace(/\s+/g, ' ').slice(0, 110)
      const from = p._from ? '〈来自 ' + p._from + '〉' : ''
      const hitTxt = Number(x.hit) >= 1 ? Math.round(Number(x.hit)) : Number(x.hit).toFixed(2)
      return '· #' + p.id + ' ' + p.title + from + '（' + fmtDay(p.born) + '，命中 ' + hitTxt + '）\n  ' + body
    })
    // 顺手把这次检索记进审计
    try {
      audit('search', {
        sea, query: query.slice(0, 80), hits: scored.length,
        shown: Math.min(limit, scored.length),
      })
    } catch {}

    return {
      ok: true,
      log: '识海里跟「' + query + '」最像的 ' + Math.min(limit, scored.length) + ' 条：\n'
        + lines.join('\n') + bodyNote,
    }
  },
}

