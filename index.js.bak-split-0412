   * 包一层，至少知道是哪个挂的、挂在哪。
   */
  let _effN = 0
  const safeEffect = (fn, tag) => {
    _effN++
    const n = _effN
    if (n <= 5) { try { audit('effect-call', { n, tag: tag || '' }) } catch {} }
    try {
      return ctx.effect(fn)
    } catch (e) {
      try { audit('effect-fail', { n, tag: tag || '', err: String((e && e.message) || e) }) } catch {}
