  // 这里包一层，把真实的错写盘，不然永远不知道死在哪。
  try {
    return _applyInner(ctx)
  } catch (e) {
    try {
      writeFileSync(
        join(process.env.USERPROFILE || homedir(), '.dsh', 'consciousness-load-error.txt'),
        new Date().toISOString() + '\n'
          + String((e && e.stack) || e) + '\n',
        'utf8',
      )
    } catch {}
    throw e
  }
}

function _applyInner(ctx) {
  /* 每个 ctx.effect 都单独兜住。
