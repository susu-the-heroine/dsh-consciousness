{
  "name": "dsh-consciousness2",
  "version": "0.6.1",
  "description": "识海：给 DSH 用的长期记忆插件。一条记忆一个神经元，会亮会暗会沉；也有 MCP 与 OpenAI 兼容接口，同一个自训内核。不装 Python、不联网。",
  "author": {
    "name": "苏苏侠",
    "url": "https://gitee.com/susu-the-heroine"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/susu-the-heroine/dsh-consciousness.git"
  },
  "homepage": "https://github.com/susu-the-heroine/dsh-consciousness#readme",
  "main": "index.js",
  "type": "module",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "selfupdate.mjs",
    "README.md",
    "README.en.md",
    "INSTALL.md",
    "install.ps1",
    "CHANGELOG.md",
    "assets",
    "!assets/core/probe_frames.json",
    "LICENSE",
    "LICENSE.md",
    "COPYING",
    "lib",
    "scripts/count.mjs",
    "docs/安装-离线包.md",
    "docs/自己验一遍.md",
    "docs/项目说明.md",
    "docs/发版清单.md",
    "docs/上手-第一小时.md",
    "docs/自查-检索不灵.md",
    "docs/检索实测.md",
    "docs/基准-竞品对比.md",
    "bin",
    "docs/README.en.md",
    "docs/接口-本机HTTP.md",
    "bin/sea-check.mjs",
    "docs/自检-人味.md",
    "docs/人味-通用30问.md",
    "docs/装完怎么自己验.md",
    "docs/人味-通用30问-生活版.md",
    "lib/styleharvest.js",
    "lib/style-store.js",
    "lib/style-tick.js",
    "lib/style-breaker.js",
    "lib/self-note.js",
    "lib/self-draft.js",
    "skills",
    "tests"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "ai-companion",
    "emotion",
    "forgetting-curve",
    "忆",
    "识海",
    "mcp",
    "agent"
  ],
  "bugs": {
    "url": "https://github.com/susu-the-heroine/dsh-consciousness/issues"
  },
  "bin": {
    "sea-api": "bin/sea-api.mjs",
    "sea-check": "bin/sea-check.mjs"
  },
  "scripts": {
    "audit:parity": "node scripts/parity-inventory.mjs && node scripts/parity-audit.mjs",
    "audit:emotion": "node tests/emotion-all.mjs && node tests/phase-audit.mjs",
    "audit:emotion:contrib": "node tests/emotion-contrib.mjs",
    "blind:score": "node tests/blind-score.mjs",
      "feel:check": "node tests/blind2-score.mjs && node tests/blind3-score.mjs && node tests/phase-audit.mjs",
      "feel:real": "node tests/feel-real.mjs",
      "feel:smoke": "node tests/feel-smoke.mjs",
      "train:beat": "node scripts/train-beat.mjs"
  }
}
