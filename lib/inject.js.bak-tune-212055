          audit('inject', {
            sid: String(sid).slice(0, 24),
            chars: out.length,
            core: core.length,
            related: related.length,
            recent: recent.length,
            mood: (function(){ try { return readHeart().mood || 'calm' } catch { return '?' } })(),
          })
        } catch {}
      }
      return out
    } catch {
      return ''
    }
  }

  function mountFor(agent, sid) {
