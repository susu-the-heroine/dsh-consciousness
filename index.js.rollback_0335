          res.writeHead(200, { 'content-type': 'text/html; charset=utf-8', 'cache-control': 'no-store' })
          res.end(html)
        },
      }),
    ),
  )

  // 心脏状态：读一次，顺手按时间结算
  off.push(
    ctx.effect(() =>
      ctx.webServer.register({
        kind: 'exact',
        path: '/consciousness/heart',
        handler: async (req, res) => {
          try {
            const h = tickHeart(readHeart())
            writeHeart(h)
            res.writeHead(200, { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'no-store' })
            res.end(JSON.stringify({ ok: true, energy: h.energy, fatigue: h.fatigue, updated: h.updated, lastThought: h.lastThought || null, thoughts: h.thoughts || [], intake: h.intake || null, lastAdd: h.lastAdd || 0 }))
          } catch (error) {
            res.writeHead(500, { 'content-type': 'application/json; charset=utf-8' })
            res.end(JSON.stringify({ ok: false, error: String((error && error.message) || error) }))
          }
        },
      }),
    ),
  )

  return () => {
    for (const f of off) {
      try {
        if (typeof f === 'function') f()
      } catch {
