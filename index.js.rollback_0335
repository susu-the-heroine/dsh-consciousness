/** 写之前留一份，保留 14 天 */
const BACKUP_DIR = join(HOME, '.dsh', 'consciousness-backups')
const HEART_FILE = join(HOME, '.dsh', 'consciousness-heart.json')

/** 心脏状态：能量、疲惫。没文件就新建一个满的。 */
function readHeart() {
  try {
    const j = JSON.parse(readFileSync(HEART_FILE, 'utf8').replace(/^\uFEFF/, ''))
    return {
      energy: Number.isFinite(j.energy) ? Math.max(0, Math.min(1, j.energy)) : 1,
      fatigue: Number.isFinite(j.fatigue) ? Math.max(0, Math.min(1, j.fatigue)) : 0,
      updated: Number(j.updated) || Date.now(),
      lastThought: j.lastThought && j.lastThought.title ? j.lastThought : null,
      thoughts: Array.isArray(j.thoughts) ? j.thoughts.slice(0, 30) : [],
      intake: (j.intake && typeof j.intake === 'object') ? j.intake : null,
      lastAdd: Number(j.lastAdd) || 0,
    }
  } catch {
    return { energy: 1, fatigue: 0, updated: Date.now() }
  }
}

/** 按过了多少时间结算：能量慢慢回来，太累的时候疲惫也慢慢退 */
function tickHeart(h, idleSec) {
  const now = Date.now()
  const mins = Math.max(0, (now - (h.updated || now)) / 60000)
  if (mins <= 0) return h
  // 闲着回得快，有人在动就回得慢——像真的在休息
  let pace = 1
  if (Number.isFinite(idleSec)) {
    if (idleSec > 300) pace = 1.7        // 五分钟没人：躺着回
    else if (idleSec > 30) pace = 1.0    // 刚离开
    else pace = 0.35                     // 正在被看着：先不动
  }
  const rec = mins * 0.0004 * pace               // 每分钟回一点
  const burn = mins * 0.00055                    // 活着就在耗：一天约 79%
  h.energy = Math.min(1, h.energy + rec - burn)
  // 能量低的时候疲惫涨得慢，恢复了才退
  if (h.energy < 0.35) h.fatigue = Math.min(1, h.fatigue + mins * 0.0008)
  else h.fatigue = Math.max(0, h.fatigue - mins * 0.0005)
  h.updated = now
  return h
}

function writeHeart(h) {
  try {
    writeFileSync(HEART_FILE, JSON.stringify(h), 'utf8')
  } catch {
    /* 心脏状态写不进去不影响别的 */
  }
}
function backupSea(sea) {
  try {
    const src = join(SEAS_DIR, sea, 'data.json')
    if (!existsSync(src)) return
    const dir = join(BACKUP_DIR, sea)
    mkdirSync(dir, { recursive: true })
    const d = new Date()
    const pad = (n) => String(n).padStart(2, '0')
    const name =
      d.getFullYear() +
      pad(d.getMonth() + 1) +
      pad(d.getDate()) +
      '-' +
      pad(d.getHours()) +
      pad(d.getMinutes()) +
      pad(d.getSeconds()) +
      '.json'
    copyFileSync(src, join(dir, name))
    const cutoff = Date.now() - 14 * 86400000
    for (const f of readdirSync(dir)) {
      const fp = join(dir, f)
      try {
        if (statSync(fp).mtimeMs < cutoff) unlinkSync(fp)
      } catch {
        /* 忽略 */
      }
    }
  } catch {
    /* 备份失败不能挡住写入 */
  }
}

function readMeta(sea) {
  try {
    const p = join(SEAS_DIR, sea, 'meta.json')
    if (!existsSync(p)) return null
    return JSON.parse(readFileSync(p, 'utf8').replace(/^\uFEFF/, ''))
  } catch {
    return null
  }
}

function writeMeta(sea, meta) {
  try {
    writeFileSync(join(SEAS_DIR, sea, 'meta.json'), JSON.stringify(meta, null, 2), 'utf8')
    return true
  } catch {
    return false
  }
}

/** 哪个识海已经认了这个窗口 */
function seaForSession(sid) {
  if (!sid) return ''
  try {
    for (const name of readdirSync(SEAS_DIR)) {
      const m = readMeta(name)
      if (m && String(m.session || '') === String(sid)) return name
    }
  } catch {
    /* 忽略 */
  }
  return ''
}

/** 认领：把一个窗口钉到某个识海 */
function bindSession(sea, sid) {
  if (!sid || !sea) return
  const m = readMeta(sea)
  if (!m) return
  if (String(m.session || '') === String(sid)) return
  m.session = String(sid)
  writeMeta(sea, m)
}

/** 窗口（会话）列表：登记处的历史窗口 + 内存里活着的，标题优先 */
function listWindows(ctx) {
  try {
    const reg = ctx.get('workspaceRegistry') || ctx.workspaceRegistry
    const ss = ctx.get('sessions') || ctx.sessions
    const st = ctx.get('sessionTitle') || ctx.sessionTitle
    const seen = new Map()
    // 归档的会话不列：它们只是藏起来，不该出现在「绑给谁」里
    const archived = new Set()
    try {
      for (const x of (reg && reg.archivedSessionIds) || []) archived.add(String(x))
    } catch {
      /* 忽略 */
    }

    // 一、登记处里每个工作区名下的会话（历史窗口都在这儿）
    try {
      for (const w of reg && typeof reg.list === 'function' ? reg.list() : []) {
        const wname = String(
          (w && w.title) ||
            (w && w.name) ||
            String((w && w.path) || '').split(/[\\/]/).filter(Boolean).pop() ||
            '',
        )
        const label =
          wname === 'default-workspace'
            ? '默认工作区'
            : String((w && w.path) || '').split(/[\\/]/).filter(Boolean).pop() || wname
        for (const sid of (w && w.sessionIds) || []) {
          const id = String(sid)
          if (!id || archived.has(id)) continue
          if (!seen.has(id)) seen.set(id, { id, workspace: label })
        }
      }
    } catch {
      /* 忽略 */
    }

    // 二、内存里活着的会话（登记处没登记的也补上）
    try {
      for (const s of ss && typeof ss.list === 'function' ? ss.list() : []) {
        const id = String((s && s.id) || '')
        if (!id || archived.has(id) || seen.has(id)) continue
        seen.set(id, { id, workspace: '' })
      }
    } catch {
      /* 忽略 */
    }

    const out = []
    for (const item of seen.values()) {
      let title = ''
      let live = false
      try {
        const sess = ss && typeof ss.get === 'function' ? ss.get(item.id) : undefined
        if (sess) {
          live = true
          if (st && typeof st.get === 'function') {
            const snap = st.get(sess)
            title = String((snap && snap.title) || '')
          }
        }
      } catch {
        title = ''
      }
      // 没标题就别露一长串 id，取 session- 后面那 4 位当记号
      const shortId = item.id.replace(/^session-/, '').slice(0, 4) || item.id.slice(0, 4)
      const info = cachedInfo(item.id)
      const rawTitle = title || info.title
      const short = rawTitle ? String(rawTitle).replace(/\s+/g, ' ').slice(0, 10) : ''
      out.push({
        id: item.id,
        name: short || shortId,
        title: rawTitle,
        workspace: item.workspace,
        live,
        mtime: live ? Number.MAX_SAFE_INTEGER : info.mtime,
      })
    }
    // 登记处里躺着的历史记录不算「窗口」：活着的全留，历史的只留最近 8 个
    out.sort((a, b) => (b.mtime || 0) - (a.mtime || 0))
    const live = out.filter((x) => x.live)
    const hist = out.filter((x) => !x.live).slice(0, 8)
    return live.concat(hist)
  } catch {
    return []
  }
}

/** 标题 + 最近活跃时间的后备来源：DSH 的会话投影缓存 */
function cachedInfo(id) {
  try {
    const dir = join(HOME, '.dsh', 'storages', 'session_projcache', 'sessions')
    const bare = String(id).replace(/^session-/, '')
    const cands = [id + '.json', bare + '.json', 'session-' + bare + '.json']
    for (const c of cands) {
      const p = join(dir, c)
      if (!existsSync(p)) continue
      let mtime = 0
      try {
        mtime = statSync(p).mtimeMs
      } catch {
        mtime = 0
      }
      try {
        const j = JSON.parse(readFileSync(p, 'utf8').replace(/^\uFEFF/, ''))
        const t = j && j.record && j.record.rows && j.record.rows.title && j.record.rows.title.val
        return { title: t ? String(t) : '', mtime }
      } catch {
        return { title: '', mtime }
      }
    }
  } catch {
    /* 忽略 */
  }
  return { title: '', mtime: 0 }
}

/** 首次安装时把两个示例识海放进去（已存在就跳过，不覆盖用户数据） */
function ensureSamples() {
  try {
    const src = join(HERE, 'assets', 'samples')
    if (!existsSync(src)) return
    if (!existsSync(SEAS_DIR)) mkdirSync(SEAS_DIR, { recursive: true })
    for (const name of readdirSync(src)) {
      const from = join(src, name)
      const to = join(SEAS_DIR, name)
      if (existsSync(to)) continue
      mkdirSync(to, { recursive: true })
      for (const f of readdirSync(from)) {
        const fp = join(from, f)
        if (statSync(fp).isFile()) copyFileSync(fp, join(to, f))
      }
    }
  } catch {
    /* 放不进去就算了，不影响主流程 */
  }
}

function pickPython() {
  for (const p of PY_CANDIDATES) {
    if (p === 'python') return p
    try {
      if (existsSync(p)) return p
    } catch {
      /* 忽略 */
    }
  }
  return 'python'
}

/** 跑一次 add_memory.py，把 stdout 原样带回来 */
function run(args, timeoutMs = 90000) {
  return new Promise((done, fail) => {
    execFile(
      pickPython(),
      [SCRIPT, ...args],
      {
        timeout: timeoutMs,
        windowsHide: true,
        maxBuffer: 8 * 1024 * 1024,
        env: { ...process.env, PYTHONIOENCODING: 'utf-8', PYTHONUTF8: '1' },
      },
      (err, stdout, stderr) => {
        const out = String(stdout || '').trim()
        const errText = String(stderr || '').trim()
        if (err && !out) {
          const raw = errText || err.message || '执行失败'
          if (/ENOENT|not recognized|不是内部或外部命令|No such file/i.test(raw)) {
            return fail(
              new Error('没找到 Python。装一个 Python 3.9+ 再重启 DSH —— 页面能看，但写不了记忆。'),
            )
          }
          return fail(new Error(raw.slice(-600)))
        }
        done(out || errText)
      },
    )
  })
}

