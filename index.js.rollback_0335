      if (f >= 70) mood = ' · 很累，话说短一点，别硬撑场面'
      else if (f >= 45) mood = ' · 有点乏，别太热闹'
      else if (e <= 12) mood = ' · 电量见底，话少一点'
      const last = (h.lastThought && h.lastThought.title) ? ('\n它最近想起：' + h.lastThought.title) : ''
      return { ok: true, log: body + '\n\n心脏：能量 ' + e + '%，疲惫 ' + f + '%' + mood + last }
    } catch {
      return { ok: true, log: body }
    }
  },
}

/* 中文分词：二字 + 三字。
 * 原来只有二字，「车站」会跟「车」撞上；加了停用词过滤和三字，
 * 「车站」这种具体的组合才立得住。 */
const STOP_CHARS = new Set('的了是在有和就不都一也人与这那之着过吗呢吧啊哦嗯')
function gramsOf(s, opts) {
  const set = new Set()
  const only = String(s || '').replace(/[^\u4e00-\u9fa5A-Za-z0-9]/g, '')
  // 二字：两边都是停用字就跳过
  for (let i = 0; i < only.length - 1; i++) {
    const a = only[i], b = only[i + 1]
    if (STOP_CHARS.has(a) && STOP_CHARS.has(b)) continue
    set.add(only.slice(i, i + 2))
  }
  // 三字：更具体，命中时权重更高
  for (let i = 0; i < only.length - 2; i++) set.add(only.slice(i, i + 3))
  // 单字：文档侧总有；查询侧只在很短的时候加（「钱」「走」「死」）。
  // 长查询加单字会污染——问「车站」会被「车」和「站」带偏。
  const useSingle = !opts || opts.single !== false
  if (useSingle) {
    for (const ch of only) {
      if (STOP_CHARS.has(ch)) continue
      set.add(ch)
    }
  }
  return set
}

/* 同义扩展：问到这些词，也去找它们常出现的那几个字。
 * 例：问「吵架」，也要能翻到「骂」「凶」「气」。 */
const SYNONYMS = [
  ['吵架', '骂 凶 气 吵 闹'],
  ['难过', '哭 难受 委屈 崩'],
  ['高兴', '笑 开心 爽 乐'],
  ['累', '疲惫 撑不住 困 倦'],
  ['离开', '走 消失 不在 走人'],
  ['想念', '想 惦记 记得'],
  ['道歉', '对不起 抱歉 认错'],
]
function expandQuery(q) {
  const extra = []
  for (const [k, vs] of SYNONYMS) {
    if (q.includes(k) || q.includes(k.slice(0, 2))) {
      for (const v of vs.split(' ')) if (v) extra.push(v)
    }
  }
  return extra
}

const seaPath = (sea) => join(SEAS_DIR, sea, 'data.json')
function readSea(sea) {
  const p = seaPath(sea)
  if (!existsSync(p)) return null
  try {
    return JSON.parse(readFileSync(p, 'utf8').replace(/^\uFEFF/, ''))
  } catch {
    return null
  }
}
function writeSea(sea, data) {
  const p = seaPath(sea)
  const tmp = p + '.tmp'
  try {
    writeFileSync(tmp, JSON.stringify(data), 'utf8')
    renameSync(tmp, p)
    return true
  } catch {
    return false
  }
}

/** 被想起一次：强度涨一截，记下次数和时间。
 *  这是间隔重复——想三次的事比想一次的事难忘三倍，不是拍脑袋。 */
function reinforcePoint(p) {
  const now = Date.now()
  const a = typeof p.arousal === 'number' ? p.arousal : 5
  const s0 = Number(p.strength) || (30 + a * 6)
  // 强度乘 1.55 再加 0.5，封顶一年
  p.strength = Math.min(365, s0 * 1.55 + 0.5)
  p.recallCount = (Number(p.recallCount) || 0) + 1
  p.lastSeen = now
  // arousal 也涨一点，但有天花板
  p.arousal = Math.min(10, a + 0.1)
  return p
}

function fmtDay(ms) {
  try {
    const d = new Date(Number(ms) || 0)
    const pad = (n) => String(n).padStart(2, '0')
    return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate())
  } catch {
    return '未知'
  }
}

/* 图游走：从命中的几条出发，沿边往外扩。
 * 这是 HippoRAG 的思路（Personalized PageRank），衰减系数 0.85。
 * 好处：问「那次吵架」，能顺着边翻出「他骂我」和「后来和好」——
 * 不是字面撞上，是走过去的。 */
function expandByGraph(seedIds, data, steps = 3, damp = 0.85) {
  const adj = new Map()
  for (const e of (data.edges || [])) {
    const a = e.a, b = e.b, w = Number(e.w) || 0.3
    if (!adj.has(a)) adj.set(a, [])
    if (!adj.has(b)) adj.set(b, [])
    adj.get(a).push({ to: b, w })
    adj.get(b).push({ to: a, w })
  }
  const score = new Map()
  const queue = []
  for (const id of seedIds) {
    score.set(id, 1)
    queue.push({ id, w: 1, d: 0 })
  }
  while (queue.length) {
    const cur = queue.shift()
    if (cur.d >= steps) continue
    for (const nb of (adj.get(cur.id) || [])) {
      const nw = cur.w * damp * nb.w
      if (nw < 0.02) continue
      if (nw > (score.get(nb.to) || 0)) {
        score.set(nb.to, nw)
        queue.push({ id: nb.to, w: nw, d: cur.d + 1 })
      }
    }
  }
  return score
}

const searchTool = {
  name: 'memory_search',
  description:
    '按词查识海里的旧记忆——不管它多久以前写的。memory_list 只给最近十条，'
    + '想找「三个月前那件事」就用这个。返回最像的几条，带日期。',
  parameters: {
    type: 'object',
    properties: {
      query: { type: 'string', description: '要查的词或一句话' },
      sea: { type: 'string', description: '哪个识海（id），不填就是 main' },
      limit: { type: 'number', description: '最多返回几条，默认 6' },
    },
    required: ['query'],
    additionalProperties: false,
  },
  output: {
    schema: { type: 'object', properties: { ok: { type: 'boolean' }, log: { type: 'string' } } },
    render: (_a, v) => text(v && v.log),
  },
  async execute(args) {
    const sea = String((args && args.sea) || 'main').trim() || 'main'
    const limit = Math.max(1, Math.min(12, Number((args && args.limit) || 6)))
    const query = String((args && args.query) || '').trim()
    if (!query) return { ok: false, log: '要查什么？给我一个词。' }
    const data = readSea(sea)
    if (!data || !Array.isArray(data.points)) return { ok: false, log: '读不到识海：' + sea }

    const q = gramsOf(query, { single: String(query).length <= 1 })
    if (!q.size) return { ok: false, log: '这个词里没有能比对的字。' }
    // 同义扩展：把近义词也算成查询的一部分
    const extraQ = expandQuery(query)
    for (const w of extraQ) for (const g of gramsOf(w, { single: false })) q.add(g)

    // 先算一遍每个字的稀有度：常见字（说、我、要）权重低，少见字权重高
    const df = new Map()
    for (const p of data.points) {
      if (p.dead) continue
      const g = gramsOf(String(p.title || '') + ' ' + String(p.text || ''))
      for (const w of g) df.set(w, (df.get(w) || 0) + 1)
    }
    const N = data.points.length
    const idf = (w) => Math.log(1 + N / (df.get(w) || 1))

    const scored = []
    for (const p of data.points) {
      if (p.dead) continue
      const g = gramsOf(String(p.title || '') + ' ' + String(p.text || ''))
      // 命中加权：三字比两字值钱，稀有字比常见字值钱
      let hit = 0
      for (const w of q) {
        if (!g.has(w)) continue
        hit += (w.length === 3 ? 2 : 1) * idf(w)
      }
      if (hit <= 0) continue
      const qlen = Math.max(1, [...q].reduce((s, w) => s + (w.length === 3 ? 2 : 1) * idf(w), 0))
      const imp = Number(p.imp) || 0.5
      const strength = Number(p.strength) || 60
      const sNorm = Math.min(1, strength / 365)
      const score = hit / qlen * 0.7 + imp * 0.15 + sNorm * 0.15
      scored.push({ p, hit, score })
    }
    if (!scored.length) return { ok: true, log: '识海里没有跟「' + query + '」对得上的。' }
    scored.sort((a, b) => b.score - a.score)

    // 顺着边往外走：命中的作为种子，扩散到的也算
    try {
      const seeds = scored.slice(0, 5).map((x) => x.p.id)
      const walk = expandByGraph(seeds, data, 2, 0.85)
      const byId = new Map()
      for (const p of data.points) byId.set(p.id, p)
      for (const [id, w] of walk) {
        if (seeds.includes(id)) continue
        const p = byId.get(id)
        if (!p || p.dead) continue
        // 走过来的分数打折：直接命中权重更高
        scored.push({ p, hit: w * 2, score: w * 0.22 })
      }
      scored.sort((a, b) => b.score - a.score)
    } catch {
      /* 图走失败不影响直接命中 */
    }

    // 想起了一条，记进心脏：这是它「活着」的证据
    try {
      const top = scored[0].p
      const h = tickHeart(readHeart())
      h.lastThought = { title: String(top.title || ''), at: Date.now() }
      writeHeart(h)
    } catch {
      /* 记账失败不影响搜索 */
    }

    // 被想起的这几条：强度涨一截，写回数据
    try {
      let changed = false
      for (const x of scored.slice(0, limit)) {
        reinforcePoint(x.p)
        x.p.lastSeen = x.p.lastSeen || Date.now()
        changed = true
      }
      if (changed) {
        backupSea(sea)
        writeSea(sea, data)
      }
    } catch {
      /* 强化失败不影响这次搜索 */
    }

    const lines = scored.slice(0, limit).map((x) => {
      const p = x.p
      const body = String(p.text || '').replace(/\s+/g, ' ').slice(0, 110)
      return '· #' + p.id + ' ' + p.title + '（' + fmtDay(p.born) + '，命中 ' + x.hit + '）\n  ' + body
    })
    return {
      ok: true,
      log: '识海里跟「' + query + '」最像的 ' + Math.min(limit, scored.length) + ' 条：\n' + lines.join('\n'),
    }
  },
}

